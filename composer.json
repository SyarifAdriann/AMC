{
    "name": "syarifadriann/amc",
    "description": "AMC - Apron Movement Control. Aircraft movement logging, stand allocation and ML stand recommendation for a single airport apron.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-session": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "check": "php tests/run_all.php"
    },
    "config": {
        "sort-packages": true
    }
}
